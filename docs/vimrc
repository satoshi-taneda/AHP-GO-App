" ── Swapファイル検出時 ───────────────────────────────────────
""autocmd SwapExists * let v:swapchoice = 'a'
autocmd SwapExists * call s:WarnSwapExists()
function! s:WarnSwapExists() abort
  echohl WarningMsg
  echom "⚠ 既に編集中のファイルです: " . expand("<afile>") . " (swap: " . v:swapname . ")"
  echohl None
  redraw
  sleep 1
  let v:swapchoice = 'a'
endfunction

