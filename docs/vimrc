" ── LSP 設定 ─────────────────────────────────────────────────
" vim-lsp-settings が typescript-language-server を自動でインストール
" :LspInstallServer を実行すると現在のファイルタイプ用サーバーが入る

if executable('/usr/local/bin/typescript-language-server')
  au User lsp_setup call lsp#register_server({
        \ 'name': 'typescript-language-server',
        \ 'cmd': {server_info->['/usr/local/bin/typescript-language-server', '--stdio']},
        \ 'allowlist': ['typescript', 'typescript.tsx', 'typescriptreact', 'javascript', 'javascriptreact'],
        \ })
endif

" LSP 機能のキーマップ（LSP接続時のみ有効）
function! s:on_lsp_buffer_enabled() abort
  setlocal omnifunc=lsp#complete

  nmap <buffer> gd <plug>(lsp-definition)
                                                " 型定義ジャンプ
  nmap <buffer> gy <plug>(lsp-type-definition)
                                                " 参照一覧
  nmap <buffer> gr <plug>(lsp-references)
                                                " 実装ジャンプ
  nmap <buffer> gi <plug>(lsp-implementation)
                                                " ホバー（型情報・ドキュメント表示）
  nmap <buffer> K  <plug>(lsp-hover)
                                                " リネーム
  nmap <buffer> <leader>rn <plug>(lsp-rename)
                                                " コードアクション（クイックフィックス等）
  nmap <buffer> <leader>ca <plug>(lsp-code-action)
                                                " 前後のエラーに移動
  nmap <buffer> [g <plug>(lsp-previous-diagnostic)
  nmap <buffer> ]g <plug>(lsp-next-diagnostic)
                                                " エラー一覧
  nmap <buffer> <leader>e <plug>(lsp-document-diagnostics)
endfunction
augroup lsp_install
  autocmd!
  autocmd User lsp_buffer_enabled call s:on_lsp_buffer_enabled()
augroup END

