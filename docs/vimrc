" ── コメント整列 ─────────────────────────────────────────────
nnoremap <leader>aa :%call AlignComment()<CR>
function! AlignComment() range
  let maxcol = 0
  for lnum in range(a:firstline, a:lastline)
    let text = getline(lnum)
    let idx = match(text, ' // ')
    if idx < 0
      continue
    endif
    let width = strdisplaywidth(strpart(text, 0, idx))
    if width > maxcol
      let maxcol = width
    endif
  endfor

  for lnum in range(a:firstline, a:lastline)
    let text = getline(lnum)
    let idx = match(text, ' // ')
    if idx < 0
      continue
    endif
    let before = strpart(text, 0, idx)
    let after = strpart(text, idx)
    let pad = maxcol - strdisplaywidth(before)
    call setline(lnum, before . repeat(' ', pad) . after)
  endfor
endfunction

" ── コメント処理 ─────────────────────────────────────────────
vnoremap cc :<C-U>'<,'>call ToggleComment()<CR>
function! ToggleComment() range
  for lnum in range(a:firstline, a:lastline)
    let text = getline(lnum)
    if text =~# '^// '
      let newtext = substitute(text, '^// ', '', '')
    else
      let newtext = '// ' . text
    endif
    call setline(lnum, newtext)
  endfor
endfunction

